# Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL pública de la app (para links de aprobación)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------
# Secrets de Edge Functions (NO van en el frontend — se configuran con
# `supabase secrets set` en el proyecto de Supabase):
#   ANTHROPIC_API_KEY=sk-ant-...
#   OPENAI_API_KEY=sk-...          (Whisper para transcripción de audios)
#   D360_WEBHOOK_SECRET=...        (verificación de firma del webhook)
#   APP_URL=https://tu-app.vercel.app
# ------------------------------------------------------------------
